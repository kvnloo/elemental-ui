{
  "name": "elemental-ui-workspace",
  "private": true,
  "license": "GPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "docs:prepare": "node docs/.vitepress/prepare-runtime.mjs",
    "docs:dev": "npm run docs:prepare && vitepress dev docs",
    "docs:build": "npm run docs:prepare && vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "vitepress": "^1.6.4",
    "vue": "^3.5.44"
  }
}
